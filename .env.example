# ==============================================================================
# Enterprise Legal & Contracts Intelligence Platform - Environment Blueprint
# Copy this file to '.env' and adjust settings for your environment.
# ==============================================================================

# Application Settings
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# Database Configuration (Defaults to local SQLite)
DATABASE_URL=sqlite:///./chatbot.db

# LLM Configuration (Local Ollama by default, OpenAI / Groq optional)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=550
LLM_TIMEOUT=180.0
OPENAI_API_KEY=
GROQ_API_KEY=

# Embedding Model Configuration (Local Ollama nomic-embed-text)
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://127.0.0.1:11434
EMBEDDING_TIMEOUT=30.0

# Vector Store Configuration (ChromaDB Cosine HNSW)
VECTOR_STORE_PROVIDER=chromadb
CHROMA_COLLECTION=rag_knowledge_base
CHROMA_PERSIST_DIRECTORY=backend/chroma_db

# RAG & Retrieval Parameters
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.25
RAG_ENABLE_RERANKING=true
RAG_ENABLE_BM25_HYBRID=true

# Security & Redaction
MASK_PII_ENABLED=true
SANITIZE_PROMPTS=true
