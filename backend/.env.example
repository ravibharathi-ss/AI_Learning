# OpenAI API Key (leave empty to use Simulated Mock AI Agent)
OPENAI_API_KEY=

# Database Connection (defaults to local SQLite file)
# For SQL Server, use: mssql+pyodbc://username:password@server/database?driver=ODBC+Driver+17+for+SQL+Server
DATABASE_URL=sqlite:///./chatbot.db

# Server Configuration
HOST=127.0.0.1
PORT=8000
